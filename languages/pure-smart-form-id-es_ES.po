msgid "Delete"
msgstr "Eliminar"

msgid "Test mode"
msgstr "Modo prueba"

msgid "Delete all tokens (test mode)"
msgstr "Eliminar todos los tokens (modo prueba)"

msgid "Delete ALL tokens permanently? This cannot be undone."
msgstr "¿Eliminar TODOS los tokens permanentemente? Esto no se puede deshacer."

